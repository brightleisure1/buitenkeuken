# Wachtwoord waarmee je (en je collega's) binnenkomen
APP_PASSWORD=kies-een-sterk-wachtwoord

# Supabase: Project Settings → API
SUPABASE_URL=https://jouwproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optioneel: sleutel waarmee de API-sleutels versleuteld worden opgeslagen.
# Laat je dit leeg, dan wordt APP_PASSWORD gebruikt. Let op: verander je deze
# later, dan moet je de API-sleutels opnieuw invullen bij Instellingen.
ENCRYPTION_KEY=

# Optioneel: API-sleutels hier zetten in plaats van op het instellingenscherm.
# Sleutels op het instellingenscherm gaan voor.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
